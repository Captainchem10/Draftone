# .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────────────
# Store sensitive configuration here. This file is gitignored.
# Access values in app.py with: st.secrets["key"]
# ─────────────────────────────────────────────────────────────────────────

# Example: Password-protect the dashboard
# [auth]
# password = "your-dashboard-password"

# Example: Connect to a remote database instead of local Excel files
# [database]
# host = "your-db-host"
# port = 5432
# name = "esg_db"
# user = "readonly_user"
# password = "db-password"

# Example: API keys for ESG data providers
# [msci]
# api_key = "your-msci-api-key"

# [sustainalytics]
# api_key = "your-sustainalytics-key"
